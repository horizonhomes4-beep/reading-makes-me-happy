rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isInstructor() { return signedIn() && request.auth.token.labAdmin == true; }
    match /instructorRequests/{uid} {
      // A user may submit or update only their own pending request. They cannot approve themselves.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','displayName','reason','status','requestedAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','displayName','reason','status','requestedAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read: if isInstructor() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;
    }
    match /sharedEmails/{studentUid} {
      allow create, update: if signedIn()
        && request.auth.uid == studentUid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'studentUid', 'studentEmail', 'gmailAccount', 'sender',
          'subject', 'body', 'messageId', 'sharedAt'
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.subject is string
        && request.resource.data.sender is string;
      allow read: if isInstructor() || (signedIn() && request.auth.uid == studentUid);
      allow delete: if isInstructor() || (signedIn() && request.auth.uid == studentUid);
    }

    match /{collectionName}/{recordId} {
      function validSharedRecord() {
        return request.resource.data.studentUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['studentUid','studentEmail','record','sharedAt','source','consentedAt'])
          && request.resource.data.record is map
          && request.resource.data.record.keys().hasOnly(['date','contact','phone','body','type','duration'])
          && request.resource.data.source == 'student_import';
      }
      allow create: if signedIn()
        && (collectionName == 'sharedSms' || collectionName == 'sharedCalls')
        && validSharedRecord();
      allow read: if (collectionName == 'sharedSms' || collectionName == 'sharedCalls')
        && (isInstructor() || (signedIn() && resource.data.studentUid == request.auth.uid));
      allow update: if false;
      allow delete: if (collectionName == 'sharedSms' || collectionName == 'sharedCalls')
        && (isInstructor() || (signedIn() && resource.data.studentUid == request.auth.uid));
    }
  }
}
